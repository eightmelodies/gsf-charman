require 'net/http'
require 'json'

module Lumnis
  MAX_LUMNIS_VALUE = 7300
  MAX_RESOURCE_VALUE = 50000

  LUMNIS_2X_PATTERN = /^You have (?<l2>[\d,]{1,5}) points? of doubled experience remaining on your Gift of Lumnis/
  LUMNIS_3X_PATTERN = /^You have (?<l3>[\d,]{1,5}) points? of tripled experience remaining on your Gift of Lumnis/
  LUMNIS_4X_PATTERN = /^You have (?<l4>[\d,]{1,5}) points? of quadrupled experience remaining on your Gift of Lumnis/
  LUMNIS_5X_PATTERN = /^You have (?<l5>[\d,]{1,5}) points? of quintupled experience remaining on your Gift of Lumnis/
  LUMNIS_EXPIRED_PATTERN = /^Your Gift of Lumnis has expired for this week./
  NO_DONATIONS_PATTERN = /You have not made any recent donations to the Temple of Lumnis./
  NUM_DONATIONS_PATTERN = /You have made (?<donations>\d+) recent donation? to the Temple of Lumnis./
  LUMNIS_REFRESH_PATTERN = /It is scheduled to refresh in (?<days>\d) days?, (?:(?<hours>\d{1,2}) hours? and )?(?<minutes>\d{1,2}) minutes?/
  LUMNIS_START_PATTERN = /It is scheduled to refresh|restart as soon as you absorb experience|Because your account is free,/

  SECONDS_IN_MINUTE = 60
  SECONDS_IN_HOUR = 60 * SECONDS_IN_MINUTE
  SECONDS_IN_DAY = 24 * SECONDS_IN_HOUR

  @lumnis_2x = nil
  @lumnis_3x = nil
  @lumnis_4x = nil
  @lumnis_5x = nil
  @donations = nil
  @resource = nil
  @refresh = nil

  def self.check
    result = Lich::Util.issue_command("lumnis info", LUMNIS_START_PATTERN, silent: true, quiet: true, usexml: false).join

    self.update_lumnis(result)
    self.update_refresh(result)
    self.update_donations(result)

    # TODO: For now this works, but if it's unreliable we'll eventually need to build either our own proc that can handle the variable lines in the resources command
    # or determine if a character is capable of generating resources by looking at profession/spell/etc data and building the end line from that
    # One thing I've noticed so far is that the voln-favor script will call this same command and if it happens at the same time ours will bleed through
    # Might be worth just seeing how fresh this data is without us calling the command each time
    end_line = Resources.weekly.nil? ? /Voln Favor:/ : /Suffused/
    Lich::Util.issue_command("resource", /^Health:/, end_line, silent: true, quiet: true)
  end

  def self.update_lumnis(result)
    case result
    when LUMNIS_5X_PATTERN
      @lumnis_5x = $~[:l5].delete(",").to_i
      @lumnis_4x = @lumnis_3x = @lumnis_2x = MAX_LUMNIS_VALUE
    when LUMNIS_4X_PATTERN
      @lumnis_5x = 0
      @lumnis_4x = $~[:l4].delete(",").to_i
      @lumnis_3x = @lumnis_2x = MAX_LUMNIS_VALUE
    when LUMNIS_3X_PATTERN
      @lumnis_5x = @lumnis_4x = 0
      @lumnis_3x = $~[:l3].delete(",").to_i
      @lumnis_2x = MAX_LUMNIS_VALUE
    when LUMNIS_2X_PATTERN
      @lumnis_5x =  @lumnis_4x = @lumnis_3x = 0
      @lumnis_2x = $~[:l2].delete(",").to_i
    when LUMNIS_EXPIRED_PATTERN
      @lumnis_5x = @lumnis_4x = @lumnis_3x = @lumnis_2x = 0
    end
  end

  def self.lumnis_2x
    @lumnis_2x
  end

  def self.lumnis_3x
    @lumnis_3x
  end

  def self.lumnis_4x
    @lumnis_4x
  end

  def self.lumnis_5x
    @lumnis_5x
  end

  def self.donations
    @donations
  end

  def self.update_donations(result)
    @donations = result =~ NO_DONATIONS_PATTERN ? 0 : result =~ NUM_DONATIONS_PATTERN ? $~[:donations].to_i : nil
  end

  def self.resource
    @resource = Resources.weekly
    @resource
  end

  def self.update_refresh(result)
    unless result =~ LUMNIS_REFRESH_PATTERN
      @refresh = nil
      return
    end

    seconds_to_add = ($~[:days].to_i * SECONDS_IN_DAY) + ($~[:hours].to_i * SECONDS_IN_HOUR) + ($~[:minutes].to_i * SECONDS_IN_MINUTE)
    now = Time.now.getutc
    @refresh = now + seconds_to_add
  end

  def self.refresh
    @refresh
  end
end

module CharmanAPI
  def self.api_url
    UserVars.charman[:api_url] || 'http://localhost:8000'
  end

  def self.get_http
    uri = URI.parse(api_url)
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = (uri.scheme == 'https')
    http.open_timeout = 3
    http.read_timeout = 3
    http.write_timeout = 3
    http
  end

  def self.create_character(character_name)
    http = self.get_http
    char_uri = URI.parse("#{self.api_url}/characters/#{URI.encode_www_form_component(character_name)}")
    request = Net::HTTP::Post.new(char_uri.path)
    request['Content-Type'] = 'application/json'
    request.body = { name: character_name }.to_json
    http.request(request)
  end

  def self.get_character(character_name)
    http = self.get_http
    char_uri = URI.parse("#{self.api_url}/characters/#{URI.encode_www_form_component(character_name)}")
    request = Net::HTTP::Get.new(char_uri.path)
    request['Content-Type'] = 'application/json'
    request.body = { name: character_name }.to_json
    http.request(request)
  end

  def self.create_character_if_not_exist(character_name)
    retries = 0
    begin
      self.get_character(character_name).value
    rescue Net::HTTPClientException => e
      if e.message.include?('404') && retries < 1
        create_character(character_name)
        retries += 1
        retry
      else
        raise
      end
    end
  end

  def self.update_lumnis(character_name, lumnis_2x, lumnis_3x, lumnis_4x, lumnis_5x, donations, resource, refresh)
    self.create_character_if_not_exist(character_name)

    http = self.get_http
    lumnis_uri = URI.parse("#{self.api_url}/characters/#{URI.encode_www_form_component(character_name)}/lumnis")
    payload = {
      name: character_name,
      lumnis_5x: lumnis_5x,
      lumnis_4x: lumnis_4x,
      lumnis_3x: lumnis_3x,
      lumnis_2x: lumnis_2x,
      donations: donations,
      weekly_resource: resource,
      refresh: refresh.utc.iso8601,
      last_update: Time.now.utc.iso8601
    }
    request = Net::HTTP::Put.new(lumnis_uri.path)
    request['Content-Type'] = 'application/json'
    request.body = payload.to_json
    http.request(request)
  end

  def self.update_session(character_name, logged_in=true)
    self.create_character_if_not_exist(character_name)

    http = self.get_http
    session_uri = URI.parse("#{self.api_url}/characters/#{URI.encode_www_form_component(character_name)}/session")
    payload = {
      last_update: Time.now.utc.iso8601,
      last_logon: ($login_time ? $login_time.utc.iso8601 : nil),
      is_logged_in: logged_in
    }
    request = Net::HTTP::Put.new(session_uri.path)
    request['Content-Type'] = 'application/json'
    request.body = payload.to_json
    http.request(request)
  end

  def self.get_pending_logout_request(character_name)
    http = self.get_http
    char_uri = URI.parse("#{self.api_url}/characters/#{URI.encode_www_form_component(character_name)}/pending-logout-request")
    request = Net::HTTP::Get.new(char_uri.path)
    request['Content-Type'] = 'application/json'
    request.body = { name: character_name }.to_json
    http.request(request)
  end
end

module LogoutHandler
  @should_logout = false
  @started_logout = false

  def self.is_logout_pending?
    return true if @should_logout

    response = CharmanAPI.get_pending_logout_request(Char.name)
    return false unless response.is_a?(Net::HTTPSuccess)

    begin
      logout_requested = JSON.parse(response.body, symbolize_names: true)[:logout_requested]
      if logout_requested
        Lich::Messaging.msg("info", "LOGOUT REQUESTED BY CHARMAN API")
        @should_logout = true
      end
      return logout_requested
    rescue JSON::ParserError => e
      return false
    end
  end

  def self.run
    return unless is_logout_pending?
    return if @started_logout
    start_script("charmanlogout")
    @started_logout = true
  end
end

# TODO: this goes into charmanlogon.lic and we spawn that so people can define their own behavior?
module CharmanState
  def self.wait_startup
    Lich::Messaging.msg("info", "Waiting for startup scripts to finish...")
    wait_while { Script.running?("invdb") }
    wait_while { Script.running?("lumnismon") }
    wait_while { Script.running?("eloot") }
    sleep(3)
  end

  def self.init_if_dead
    return unless dead?

    Lich::Messaging.msg("info", "We're dead, departing!")
    2.times { fput "depart" };
    2.times { fput "depart confirm" };
  end

  def self.init_if_sting
    return unless Experience.deaths_sting != "None"

    Lich::Messaging.msg("info", "We have death's sting, running sting.lic")
    Script.run("sting")
  end

  def self.init_if_not_in_town
    # TODO: this can be improved. shouldn't matter if we logoff in the nexus like normal
    return unless [66666, 2300, 318].include? Room.current.id
    Lich::Messaging.msg("info", "Not in town, running back to town")
    Script.run("go2", "town --disable-confirm")
  end

  def self.init_if_spirit_low
    return if Char.percent_spirit == 100

    Lich::Messaging.msg("info", "Waiting for spirit to recover...")
    if Spell[9824].known?
      pause_script("nudge", "nudge_buff", "ewaggle")
      Spell[9824].cast
      sleep(1) until !Spell[9824].active?
      unpause_script("nudge", "nudge_buff", "ewaggle")
    end

    sleep(10) until Char.percent_spirit == 100
  end

  def init
    self.wait_startup
    self.init_if_dead
    self.init_if_sting
    self.init_if_not_in_town
    self.init_if_spirit_low
    # TODO
    #self.init_no_donations
  end
end

module Charman
  def self.last_session_update
    @last_session_update ||= Time.at(0)
  end

  def self.last_session_update=(time)
    @last_session_update = time
  end

  def self.last_lumnis_update
    @last_lumnis_update ||= Time.at(0)
  end

  def self.last_lumnis_update=(time)
    @last_lumnis_update = time
  end

  def self.session_interval
    UserVars.charman[:session_interval] || 30
  end

  def self.lumnis_interval
    UserVars.charman[:lumnis_interval] || 60
  end

  def self.update_session_data(character_name)
    current_time = Time.now
    if current_time - self.last_session_update >= session_interval
      Lich::Messaging.msg("debug", "Updating session data...")
      CharmanAPI.update_session(character_name)
      self.last_session_update = current_time
    end
  end

  def self.update_lumnis_data(character_name)
    current_time = Time.now
    if current_time - self.last_lumnis_update >= lumnis_interval
      Lich::Messaging.msg("debug", "Fetching Lumnis data...")
      Lumnis.check
      Lich::Messaging.msg("debug", "Updating Lumnis data...")
      CharmanAPI.update_lumnis(character_name, Lumnis.lumnis_2x, Lumnis.lumnis_3x, Lumnis.lumnis_4x, Lumnis.lumnis_5x, Lumnis.donations, Lumnis.resource, Lumnis.refresh)
      self.last_lumnis_update = current_time
    end
  end

  def self.run
    character_name = XMLData.name
    update_session_data(character_name)
    update_lumnis_data(character_name)
    LogoutHandler.run
  end
end

# Parse command line arguments
if Script.current.vars[0] =~ /^--?help$|\?$/
  _respond ""
  _respond "<pushBold/>charman.lic - Send Lumnis data to API<popBold/>"
  _respond ""
  _respond "Usage:"
  _respond "  ;charman                            - Run continuously"
  _respond "  ;charman run                        - Run once (fetch and send all data)"
  _respond "  ;charman set --url=URL              - Set API URL"
  _respond "  ;charman set --lumnis-interval=N    - Set Lumnis update interval (in seconds, default: 60)"
  _respond "  ;charman set --session-interval=N   - Set session update interval (in seconds, default: 30)"
  _respond "  ;charman set                        - Show current configuration"
  _respond "  ;charman --help                     - Show this help"
  _respond ""
  _respond "Configuration:"
  _respond "  Set UserVars.charman[:api_url] to your API endpoint (default: http://localhost:8000)"
  _respond "  Set UserVars.charman[:lumnis_interval] to Lumnis update interval in seconds (default: 60)"
  _respond ""
  exit
end

# Initialize UserVars if needed
UserVars.charman ||= {}

# Parse command - vars[0] is the full command, vars[1..] are split args
all_args = Script.current.vars

# Find subcommand in the args (skip first element which is full command)
command = nil
args = []
in_args = false

for var in all_args
  if var.nil? || var.empty?
    next
  elsif !in_args && var =~ /^(set|run)$/
    command = var
    in_args = true
  elsif in_args
    args << var
  end
end

if command.nil?
  daemon_mode = true
  # Collect all args except the first (full command)
  args = all_args[1..-1].compact
end

if command == 'run'
  daemon_mode = false
end

# Handle set subcommand
if command == 'set'
  url_set = false
  lumnis_interval_set = false
  logout_interval_set = false
  
  for var in args
    if var =~ /--?url=(.+?)$/
      UserVars.charman[:api_url] = $1
       Lich::Messaging.msg("info", "API URL set to: #{$1}")
      url_set = true
    elsif var =~ /--?lumnis-interval=(\d+)$/
      UserVars.charman[:lumnis_interval] = $1.to_i
       Lich::Messaging.msg("info", "Lumnis interval set to: #{$1} seconds")
      lumnis_interval_set = true
    elsif var =~ /--?session-interval=(\d+)$/
      UserVars.charman[:session_interval] = $1.to_i
       Lich::Messaging.msg("info", "Session interval set to: #{$1} seconds")
      session_interval_set = true
    end
  end
  
  # Show current config if nothing was set
  unless url_set || lumnis_interval_set || session_interval_set
    _respond ""
    _respond "<pushBold/>Current Configuration:<popBold/>"
    _respond "  API URL: #{UserVars.charman[:api_url] || 'http://localhost:8000'}"
    _respond "  Lumnis Interval: #{UserVars.charman[:lumnis_interval] || 60} seconds"
    _respond "  Session Interval: #{UserVars.charman[:session_interval] || 30} seconds"
    _respond ""
  end
  
  exit
end

override_lumnis_interval = nil
override_logout_interval = nil

for var in args
  if var =~ /--?lumnis-interval=(\d+)$/
    override_lumnis_interval = $1.to_i
  elsif var =~ /--?session-interval=(\d+)$/
    override_session_interval = $1.to_i
  end
end

# Use override intervals, stored intervals, or defaults
lumnis_interval = UserVars.charman[:lumnis_interval] || 60
session_interval = UserVars.charman[:session_interval] || 30

if daemon_mode
  before_dying {
    Lich::Messaging.msg("info", "Updating login state")
    CharmanAPI.update_session(XMLData.name, false)
  }

  Lich::Messaging.msg("info", "Initializing character state...")
  CharmanState.init

  Lich::Messaging.msg("info", "Starting daemon mode. Use ;k charman to stop.")
  
  loop do
    begin
      Charman.run
    rescue => e
      Lich::Messaging.msg("info", "Error: #{e.message}")
    end
    
    sleep [lumnis_interval, session_interval].min
  end
else
  Charman.run
end
